{
	// Formatting comes from .editorconfig (2-space indents) and ESLint (npm run lint).
	"typescript.tsc.autoDetect": "off",
	"eslint.useFlatConfig": true,
	"npm.packageManager": "npm",
	// npm runs in the build image (see the Makefile), not from VS Code's npm scripts view.
	"npm.autoDetect": "off"
}
