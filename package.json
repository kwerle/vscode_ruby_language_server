{
    "name": "ruby-language-server",
    "displayName": "Ruby Language Server Client",
    "description": "Language Server Client",
    "license": "MIT",
    "version": "0.1.2",
    "publisher": "KurtWerle",
    "engines": {
        "vscode": "^1.41.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:ruby",
        "onCommand:ruby-language-server.restart"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "tsc -p ./ --noEmit && node scripts/bundle.js --production",
        "compile": "tsc -p ./ && node scripts/bundle.js",
        "bundle": "node scripts/bundle.js",
        "watch": "node scripts/bundle.js --watch",
        "package": "vsce package --no-dependencies --no-yarn",
        "postinstall": "#node ./node_modules/@types/vscode/bin/install",
        "test": "tsc -p ./ && mocha"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^14.18.63",
        "@types/vscode": "^1.41.0",
        "@vscode/vsce": "^4.1.1",
        "esbuild-wasm": "^0.28.2",
        "mocha": "^12.0.3",
        "typescript": "^3.7.4"
    },
    "dependencies": {
        "vscode-languageclient": "^6.1.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kwerle/vscode_ruby_language_server.git"
    },
    "bugs": {
        "url": "https://github.com/kwerle/vscode_ruby_language_server/issues"
    },
    "contributes": {
        "commands": [
            {
                "command": "ruby-language-server.restart",
                "title": "Restart",
                "category": "Ruby Language Server"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Ruby Language Server",
            "properties": {
                "ruby-language-server.additionalGems": {
                    "type": "string",
                    "scope": "user",
                    "default": "",
                    "description": "Comma separated list of additional gems to install - usually for rubocop.\nrubocop-rails,rubocop-performance..."
                },
                "ruby-language-server.logLevel": {
                    "type": "string",
                    "scope": "user",
                    "enum": [
                        "debug",
                        "info",
                        "warn",
                        "error"
                    ],
                    "default": "error",
                    "description": "Generally only useful if you are debugging the server."
                },
                "ruby-language-server.dockerImage": {
                    "type": "string",
                    "scope": "user",
                    "default": "kwerle/ruby_language_server",
                    "description": "Name of the docker image to use for the server."
                }
            }
        }
    }
}
