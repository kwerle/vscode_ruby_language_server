{
    "compilerOptions": {
        "module": "commonjs",
        // VS Code 1.82 (the minimum in package.json) runs extensions on Node 18.
        "target": "es2022",
        "lib": ["es2022"],
        "strict": true,
        "outDir": "out",
        "sourceMap": true,
        "types": ["node", "mocha"],
        "rootDir": "."
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "dist"
    ]
}
